# ==========================================
# Environment Variables Template (.env)
# Copy to .env for local development or configure in Render Dashboard
# ==========================================

# Database:
# - Local SQLite default:
# DATABASE_URL=sqlite+pysqlite:///./work_orders.db
# - Production Supabase PostgreSQL:
# Get this from Supabase Dashboard -> Settings -> Database -> Connection string (URI)
# Direct connection (Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# Or Connection Pooler / Session mode (Port 5432):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:change-me@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Master Owner Registration Secret Code
# The database starts with NO users (no owner, no admin).
# The owner will visit the web app, enter this secret code to create the master Owner account.
# Once created, the owner can log in and create Admin / Manager accounts directly from the dashboard.
OWNER_CODE=READY-RENTALS-OWNER-2026

# Security & JWT Token
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Application URLs & CORS
# PUBLIC_BASE_URL: Your deployed backend URL on Render (e.g. https://maint-backend.onrender.com)
PUBLIC_BASE_URL=http://localhost:8000
# CORS_ORIGINS: Comma-separated allowed frontend origins (NO trailing slashes, NO wildcard '*' in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.vercel.app
ENABLE_TEST_UI=false

# File Storage (local or s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_data
MAX_UPLOAD_MB=10

# S3 Compatible Storage (optional, e.g. AWS S3 / Cloudflare R2)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Notifications (email_backend: 'log' for stdout, 'smtp', or 'sendgrid')
EMAIL_BACKEND=log
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=ReadyRentalsOnline

# SMTP / SendGrid settings (when EMAIL_BACKEND=smtp or sendgrid)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SENDGRID_API_KEY=

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
