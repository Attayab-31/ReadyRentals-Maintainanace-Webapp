# Example environment template for local development or deployed services.
# Copy this file to .env and replace placeholder values before running locally.

# Local development default (SQLite)
# DATABASE_URL=sqlite+pysqlite:///./work_orders.db

# Production default for Supabase / Render
# Example format from Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:change-me@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

JWT_SECRET=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_EMAIL=manager@example.com
ADMIN_PASSWORD=change-me-strong
ADMIN_NAME=Property Manager
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_data
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
EMAIL_BACKEND=log
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Maintenance Work Orders
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ENABLE_TEST_UI=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.vercel.app

# Deployment note:
# - PUBLIC_BASE_URL should be your deployed API origin, e.g. https://maint-backend.onrender.com
# - CORS_ORIGINS must include the deployed frontend origin exactly, not a wildcard.
# - For Supabase, paste your actual database URL from Supabase project settings; do not commit secret values.
# - Keep all real secrets in Render/Vercel environment variables instead of committed files.
