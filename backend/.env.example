# Local development settings only. Production settings are in the repository-root
# .env.production.example file.
DATABASE_URL=sqlite+pysqlite:///./work_orders.db
JWT_SECRET=local-development-secret-change-before-any-shared-use
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

OWNER_CODE=local-owner-code
OWNER_EMAIL=
OWNER_NAME=ReadyRentals Owner

PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_data
MAX_UPLOAD_MB=10

EMAIL_BACKEND=log
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=ReadyRentals
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# Optional local SMS sending through Twilio. Leave blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

COMPANY_NAME=ReadyRentals
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE=
