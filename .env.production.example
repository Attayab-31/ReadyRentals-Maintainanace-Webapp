# Copy to .env.production on the VPS and replace every CHANGE_ME value.
DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=readyrentals
POSTGRES_USER=readyrentals
POSTGRES_PASSWORD=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
OWNER_CODE=CHANGE_ME_USE_A_DIFFERENT_RANDOM_SECRET
OWNER_NAME=ReadyRentals Owner
OWNER_EMAIL=owner@example.com

EMAIL_BACKEND=smtp
MAIL_FROM=notifications@example.com
MAIL_FROM_NAME=ReadyRentals
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_STARTTLS=true
SMTP_SSL=false

# Production uses VPS-local persistent Docker volume storage.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/app/storage_data
MAX_UPLOAD_MB=10

# Optional: technician assignment SMS through Twilio. Leave blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

COMPANY_NAME=ReadyRentals
COMPANY_PHONE=
COMPANY_EMAIL=support@example.com
COMPANY_WEBSITE=https://example.com

# Generate long random secrets on the VPS, for example:
# openssl rand -hex 32
